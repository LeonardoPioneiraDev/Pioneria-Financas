# ============================================================================
# .env.docker — variáveis para subir o stack COMPLETO via Docker (containers).
#
# Diferente do .env (que é para o `pnpm dev` rodando direto no laptop).
#
#   .env         → desenvolvimento (pnpm dev, com Globus, DATABASE_HOST=localhost)
#   .env.docker  → este aqui (todos os containers, sem Globus, hostname interno)
#
# Setup:
#   cp .env.docker.example .env.docker
#   # edite .env.docker com sua senha, JWT, IP do servidor…
#   pnpm docker:app:rebuild
# ============================================================================

# ---- Postgres (interno ao compose) ----
DATABASE_USER=pioneira
DATABASE_PASSWORD=troque_isto_em_producao
DATABASE_NAME=pioneira_finance_db
DATABASE_PORT=5435       # porta exposta no host (5432 dentro do container)

# ---- Redis ----
REDIS_PORT=6379

# ---- JWT (OBRIGATÓRIO — gere com `openssl rand -base64 64`) ----
JWT_SECRET=GERE_UM_SEGREDO_LONGO_COM_OPENSSL_RAND_BASE64_64
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- SMTP ----
# Em dev: mailhog interno (já configurado).
# Em produção: aponte para seu servidor SMTP real.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Pioneira Financas
SMTP_FROM_EMAIL=nao-responda@vpioneira.com.br

# ---- Backend ----
BACKEND_PORT_HOST=3333    # porta exposta no host
LOG_LEVEL=info
APP_URL=http://localhost:3001

# ⚠ ACESSO PELA REDE LOCAL (outras máquinas chamando este servidor)
# Se for acessar de http://10.10.100.176:3001, troque acima:
#   APP_URL=http://10.10.100.176:3001
#   CORS_ORIGINS=http://10.10.100.176:3001
# (mas o CORS já libera automaticamente qualquer IP de rede privada RFC1918,
#  então CORS_ORIGINS só é obrigatório pra origens públicas com domínio).
CORS_ORIGINS=

# ---- Frontend ----
FRONTEND_PORT_HOST=3001
# ⚠ ATENÇÃO: NEXT_PUBLIC_API_URL é compilado no JS do browser.
# Se for acessar de outra máquina, NÃO use localhost — use o IP do servidor:
#   NEXT_PUBLIC_API_URL=http://10.10.100.176:3333
NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_APP_NAME=Pioneira Financas

# ---- Globus (empresa/filial alvo da Pioneira no consórcio) ----
EMPRESA_GLOBUS_ID=4         # Viação Pioneira (consórcio Bacia 2)
EMPRESA_GLOBUS_FILIAL=1     # Filial principal

# ---- Oracle / Globus (read-only) ----
# ⚠ NO DOCKER, MANTENHA false POR PADRÃO.
# A integração com o Globus exige rede interna da empresa (10.0.1.191) + Instant Client.
# Em container Docker padrão isso não funciona — o sistema continua operando com os
# dados que já foram sincronizados para o Postgres local.
ORACLE_ENABLED=false

# Se um dia precisar habilitar (em servidor com acesso à VPN):
# ORACLE_ENABLED=true
# ORACLE_HOST=10.0.1.191
# ORACLE_PORT=1521
# ORACLE_SERVICE_NAME=orcl_pdb1.sub02151801351.vcnpioneira.oraclevcn.com
# ORACLE_USER=glbconsult
# ORACLE_PASSWORD=...     # ⚠ usar Docker secrets, NUNCA hardcodar
# ORACLE_CLIENT_PATH=/opt/oracle/instantclient
# E ajustar o Dockerfile do backend para instalar o Instant Client.
