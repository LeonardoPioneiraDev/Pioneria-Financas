# Pioneira-Financas - variaveis de ambiente
# Copie para .env e ajuste para seu ambiente

# ---- App ----
NODE_ENV=development
TZ=America/Sao_Paulo

# ---- Backend ----
# DEV LOCAL usa 3334 (front 3002) pra NAO colidir com o Docker app (back 3333 / front 3001).
# O Docker tem arquivo proprio: .env.docker (ver .env.docker.example). NAO mexer nas portas do Docker.
BACKEND_PORT=3334
BACKEND_HOST=0.0.0.0
TRUST_PROXY=false

# ---- Banco de dados (PostgreSQL) ----
DATABASE_HOST=localhost
DATABASE_PORT=5435
DATABASE_USER=pioneira
DATABASE_PASSWORD=pioneira_dev
DATABASE_NAME=pioneira_finance_db
DATABASE_SCHEMA=public

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- JWT ----
JWT_SECRET=troque_em_producao_use_openssl_rand_base64_64
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- SMTP (envio de email) ----
# Em desenvolvimento, aponta para o Mailhog do docker-compose
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Pioneira Financas
SMTP_FROM_EMAIL=nao-responda@vpioneira.com.br

# ---- Frontend ----
FRONTEND_PORT=3002
NEXT_PUBLIC_API_URL=http://localhost:3334
NEXT_PUBLIC_APP_NAME=Pioneira Financas
APP_URL=http://localhost:3002

# ---- Logs / Metrics ----
LOG_LEVEL=debug
METRICS_EXCLUDED_PATHS=/health,/docs,/api/metrics/page-view

# ---- Oracle / Globus (read-only) ----
# Habilita o plugin. Em dev local sem Instant Client, manter `false`.
# Quando habilitar, instalar o Oracle Instant Client e apontar ORACLE_CLIENT_PATH.
# ==========================================
# 🗄️ CONFIGURAÇÕES DE BANCO DE DADOS ORACLE
# ==========================================
ORACLE_ENABLED=true
ORACLE_USER=glbconsult
ORACLE_PASSWORD="GlbCns2025$#001"
ORACLE_CONNECTION_STRING=//10.0.1.191:1521/orcl_pdb1.sub02151801351.vcnpioneira.oraclevcn.com
ORACLE_HOST=10.0.1.191
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=orcl_pdb1.sub02151801351.vcnpioneira.oraclevcn.com
ORACLE_CLIENT_PATH=C:\Oracle\instantclient_12_2 # Desenvolvimento
#ORACLE_CLIENT_PATH=/opt/oracle/instantclient # Produção

# Pool e timeouts (tuned para rede OCI lenta - referencia Controle de Horarios)
ORACLE_POOL_MIN=5
ORACLE_POOL_MAX=50
ORACLE_POOL_INCREMENT=2
ORACLE_POOL_TIMEOUT=18000000
ORACLE_CONNECT_TIMEOUT=1800000
ORACLE_QUERY_TIMEOUT=18000000
ORACLE_FETCH_ARRAY_SIZE=2000
ORACLE_PREFETCH_ROWS=200
ORACLE_MAX_RETRIES=3
ORACLE_RETRY_DELAY=5000
