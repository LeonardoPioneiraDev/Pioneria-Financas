# Backend - copie para .env (na raiz do monorepo) ou .env.local aqui
# As variaveis aqui sao um subset das documentadas em ../../.env.example
NODE_ENV=development
TZ=America/Sao_Paulo
# DEV LOCAL: 3334 (Docker app usa 3333 — nao mexer no Docker).
BACKEND_PORT=3334
BACKEND_HOST=0.0.0.0
TRUST_PROXY=false

DATABASE_HOST=localhost
DATABASE_PORT=5435
DATABASE_USER=pioneira
DATABASE_PASSWORD=pioneira_dev
DATABASE_NAME=pioneira_finance_db
DATABASE_SCHEMA=public

JWT_SECRET=troque_em_producao
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM_NAME=Pioneira Financas
SMTP_FROM_EMAIL=nao-responda@vpioneira.com.br

APP_URL=http://localhost:3002
LOG_LEVEL=debug
