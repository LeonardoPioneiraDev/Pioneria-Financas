{
  "name": "@pioneira/financas-backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "migration:generate": "typeorm-ts-node-esm migration:generate -d src/data-source.ts",
    "migration:run": "tsx src/scripts/run-migrations.ts",
    "migration:revert": "typeorm-ts-node-esm migration:revert -d src/data-source.ts",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "relatorio:prazo": "tsx src/scripts/gerar-relatorio-prazo.ts",
    "seed:workflow": "tsx src/scripts/seed-workflow-templates.ts",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.6.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@fastify/type-provider-typebox": "^4.0.0",
    "@pioneira/shared": "workspace:*",
    "@sinclair/typebox": "^0.32.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.4.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "fastify": "^4.26.0",
    "fastify-plugin": "^4.5.0",
    "ioredis": "^5.3.2",
    "nodemailer": "^6.9.13",
    "oracledb": "^6.10.0",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.12.0",
    "@types/nodemailer": "^6.4.14",
    "@types/oracledb": "^6.10.3",
    "pino-pretty": "^13.1.3",
    "rimraf": "^5.0.5",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.7.1",
    "typeorm-ts-node-esm": "^0.3.20",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
